<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="onNavigatingTo">
    <ActionBar title="{{ isUpdate ? 'Editar Elemento' : 'Nuevo Elemento' }}" class="action-bar" />
    
    <StackLayout class="form-container">
        <Label text="Título del producto" class="input-label" />
        <TextField text="{{ title }}" hint="Ej: Teclado Mecánico" class="input-field" />
        
        <Label text="Descripción" class="input-label" />
        <TextField text="{{ subtitle }}" hint="Ej: Switch red" class="input-field" />
        
        <Label text="¿Disponible en inventario?" class="input-label" />
        <Switch checked="{{ isActive }}" class="switch-field" />
        
        <Button text="Guardar" tap="onSave" class="btn-primary" />
    </StackLayout>
</Page>